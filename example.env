# ==============================================================================
# supportflow-ai-infra: Local Development Environment Variables
# Sao chép file này thành .env để sử dụng: cp example.env .env
# ==============================================================================

# Network & Host binding
INFRA_BIND_ADDRESS=127.0.0.1

# PostgreSQL 17
POSTGRES_DB=servicedesk
POSTGRES_USER=servicedesk
POSTGRES_PASSWORD=servicedesk_dev_secret_change_me
POSTGRES_PORT=5432

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=servicedesk-attachments

# Mailpit (Local email testing)
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
