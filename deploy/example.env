# ==============================================================================
# supportflow-ai-infra: System Deploy / Staging Environment Variables
# Sao chép file này thành .env trong thư mục deploy/: cp example.env .env
# ==============================================================================

# Gateway & Ports
GATEWAY_PORT=80

# Database PostgreSQL 16
POSTGRES_DB=servicedesk
POSTGRES_USER=servicedesk
POSTGRES_PASSWORD=generate_a_very_secure_postgres_password_here

# Object Storage MinIO
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=generate_a_very_secure_minio_password_here
MINIO_DEFAULT_BUCKET=servicedesk-attachments

# Security & JWT (Ít nhất 32 bytes UTF-8)
JWT_SECRET_KEY=generate_at_least_32_bytes_super_secret_jwt_key_here!
JWT_ISSUER=supportflow-auth
JWT_AUDIENCE=supportflow-api
JWT_EXPIRY_MINUTES=1440

# Service-to-Service AI Token
AI_S2S_BEARER_TOKEN=generate_random_secure_s2s_token_for_ai_service_here
