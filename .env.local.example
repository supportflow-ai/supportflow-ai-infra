# Explicit Development-only configuration. Never use for production.
APP_ENVIRONMENT=Development
API_IMAGE=servicedesk-api:local
WORKER_IMAGE=servicedesk-worker:local
DATABASE_IMAGE=servicedesk-database:local
WEB_IMAGE=servicedesk-web:local
MINIO_IMAGE=servicedesk-minio:local
POSTGRES_PASSWORD=local_database_password
MINIO_ROOT_USER=localminio
MINIO_ROOT_PASSWORD=local_minio_password
JWT_SECRET_KEY=local_development_signing_key_for_disposable_environments
DEMO_PASSWORD=Test@1234

RUNTIME_DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=servicedesk;Username=servicedesk;Password=local_database_password
MIGRATION_DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=servicedesk;Username=servicedesk;Password=local_database_password
